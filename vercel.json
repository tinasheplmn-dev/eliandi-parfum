{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/collectie/:naam",
      "destination": "/api/geur?collectie=:naam"
    },
    {
      "source": "/:map(home|unisex|heren|vrouwen|dames|kinderen)/:bestand([0-9]+-[^/]+)",
      "destination": "/api/geur?oud=:bestand"
    },
    {
      "source": "/geur/:slug",
      "destination": "/api/geur?slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/geur?sitemap=1"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/geur?robots=1"
    },
    {
      "source": "/feed.xml",
      "destination": "/api/geur?feed=1"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https://*.public.blob.vercel-storage.com; frame-src https://www.google.com https://maps.google.com; worker-src 'self' blob:; connect-src 'self' https://vercel.com https://*.blob.vercel-storage.com; object-src 'none'; base-uri 'self'; form-action 'self' https://www.mollie.com; frame-ancestors 'self'; upgrade-insecure-requests"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/beheer",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/beheer.html",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/admin?taak=dagelijks",
      "schedule": "0 9 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/10-vrouwen",
      "destination": "/collectie/damesparfum",
      "statusCode": 301
    },
    {
      "source": "/11-heren",
      "destination": "/collectie/herenparfum",
      "statusCode": 301
    },
    {
      "source": "/13-unisex",
      "destination": "/collectie/unisex-parfum",
      "statusCode": 301
    },
    {
      "source": "/12-kinderen",
      "destination": "/shop",
      "statusCode": 301
    },
    {
      "source": "/2-home",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/home",
      "destination": "/shop",
      "statusCode": 301
    },
    {
      "source": "/aanbiedingen",
      "destination": "/shop",
      "statusCode": 301
    },
    {
      "source": "/nieuwe-producten",
      "destination": "/shop",
      "statusCode": 301
    },
    {
      "source": "/best%20verkochte%20producten",
      "destination": "/shop",
      "statusCode": 301
    },
    {
      "source": "/prijsverlagingen",
      "destination": "/shop",
      "statusCode": 301
    },
    {
      "source": "/unisex",
      "destination": "/collectie/unisex-parfum",
      "statusCode": 301
    },
    {
      "source": "/brand/:x*",
      "destination": "/shop",
      "statusCode": 301
    },
    {
      "source": "/zoeken",
      "destination": "/shop",
      "statusCode": 301
    },
    {
      "source": "/winkelwagen",
      "destination": "/shop",
      "statusCode": 301
    },
    {
      "source": "/bestelling",
      "destination": "/shop",
      "statusCode": 301
    },
    {
      "source": "/inloggen",
      "destination": "/shop",
      "statusCode": 301
    },
    {
      "source": "/mijn-account",
      "destination": "/shop",
      "statusCode": 301
    },
    {
      "source": "/contact-opnemen",
      "destination": "/#bezoek",
      "statusCode": 301
    },
    {
      "source": "/winkels",
      "destination": "/#bezoek",
      "statusCode": 301
    },
    {
      "source": "/content/1-levering_retourbeleid",
      "destination": "/verzending-retour",
      "statusCode": 301
    },
    {
      "source": "/content/3-gebruiks-voorwaarden",
      "destination": "/verzending-retour",
      "statusCode": 301
    },
    {
      "source": "/content/4-over-ons",
      "destination": "/#verhaal",
      "statusCode": 301
    }
  ]
}
