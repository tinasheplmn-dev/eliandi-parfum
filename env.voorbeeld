# Sleutels voor Eliandi Parfum
#
# Lokaal: kopieer dit bestand naar .env.local in deze map en vul in wat
# je hebt. .env.local staat in .gitignore en gaat dus nooit naar GitHub.
#   cp env.voorbeeld .env.local
#
# Online: zet dezelfde regels in Vercel onder Settings > Environment
# Variables. Daar hoort geen .env.local te staan.

# ── Betalen (Mollie) ────────────────────────────────────────────────
# Mollie-dashboard > Developers > API keys. Begin met de testsleutel;
# live zetten is later alleen deze regel vervangen.
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Agenda van Angelo (Google) ──────────────────────────────────────
# Het adres van de agenda waar de boekingen in moeten komen.
GOOGLE_CALENDAR_ID=angelo@voorbeeld.nl
# De JSON-sleutel van het serviceaccount, op één regel tussen
# enkele aanhalingstekens. Angelo deelt zijn agenda met het
# client_email uit die JSON, met recht om afspraken te wijzigen.
GOOGLE_SERVICE_ACCOUNT_JSON='{"client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}'

# ── Bevestigingsmails (Resend) ──────────────────────────────────────
# Zonder sleutel wordt er niets verstuurd en werkt de site gewoon door.
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=Eliandi Parfum <info@eliandiparfum.com>
# MAIL_OWNER=het adres van Angelo, krijgt melding van elke boeking
# MAIL_BCC=blinde kopie van elke klantmail

# ── Beheer ──────────────────────────────────────────────────────────
# Het wachtwoord voor /beheer. Online verplicht; lokaal werkt zonder
# deze regel het wachtwoord eliandi-lokaal.
# ADMIN_PASSWORD=verzin-iets-sterks

# ── Opslag (verplicht zodra de site live staat) ─────────────────────
# Zonder deze twee verdwijnen boekingen en wijzigingen bij een herstart.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Prijzen die niet in het dashboard staan ─────────────────────────
# SHIPPING_PRICE_CENTS=495
# DISCOVERY_PRICE_CENTS=4995
# SUBSCRIPTION_PRICE_CENTS=3995
# SITE_URL=https://eliandiparfum.nl

# ── Dagelijkse taak (Vercel Cron) ───────────────────────────────────
# Vercel roept elke ochtend /api/admin?taak=dagelijks aan en stuurt dit
# geheim mee. Die taak mailt klanten die hun betaling niet afrondden
# één keer een herinnering. Zonder geheim doet de taak niets.
# CRON_SECRET=een-lange-willekeurige-tekst
